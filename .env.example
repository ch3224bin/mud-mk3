# 루트 compose.yaml 이 읽는 값. 복사해서 쓴다: cp .env.example .env
# .env 는 커밋하지 않는다(.gitignore). 실제 비밀 값은 .env 에만 둔다.

# Google OAuth 클라이언트 ID (Google Cloud Console > 사용자 인증 정보). 비우면 Google 로그인만 안 된다
GOOGLE_CLIENT_ID=
# Google OAuth 클라이언트 보안 비밀번호. world-server만 쓴다
GOOGLE_CLIENT_SECRET=
# 관리자로 볼 Google 이메일, 쉼표로 나눈다(대소문자 무시). 예: a@example.com,b@example.com
MUD_ADMIN_EMAILS=
# PostgreSQL mud 사용자 비밀번호(compose 안에서만 쓰는 DB). 꼭 채운다
POSTGRES_PASSWORD=
# world-server 스프링 프로필. 비우면 운영, 개발용 로그인을 쓰려면 local
SPRING_PROFILES_ACTIVE=
# 개발용 로그인(Google 없이 이메일로 로그인). local 프로필에서만 뜻이 있다. 운영에서는 켜지 않는다
MUD_DEV_LOGIN_ENABLED=false
