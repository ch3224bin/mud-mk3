<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                 version="3.1">
    <access>FIELD</access>

    <entity class="mudmk3.domain.zone.Zone">
        <table name="zone">
            <unique-constraint name="UK_ZONE_NAME">
                <column-name>name</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <basic name="name">
                <column name="name" length="30" nullable="false"/>
            </basic>
            <basic name="description">
                <column name="description" length="500" nullable="false"/>
            </basic>
            <many-to-one name="owner" fetch="LAZY">
                <join-column name="owner_id" nullable="true"/>
            </many-to-one>
        </attributes>
    </entity>

    <entity class="mudmk3.domain.faction.Faction">
        <table name="faction">
            <unique-constraint name="UK_FACTION_NAME">
                <column-name>name</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <basic name="kind">
                <column name="kind" length="16" nullable="false" column-definition="varchar(16)"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="name">
                <column name="name" length="30" nullable="false"/>
            </basic>
            <basic name="description">
                <column name="description" length="500" nullable="false"/>
            </basic>
        </attributes>
    </entity>

    <entity class="mudmk3.domain.room.Room">
        <table name="room"/>
        <attributes>
            <basic name="name">
                <column name="name" length="30" nullable="false"/>
            </basic>
            <basic name="description">
                <column name="description" length="1000" nullable="false"/>
            </basic>
            <many-to-one name="zone" fetch="LAZY" optional="false">
                <join-column name="zone_id" nullable="false"/>
            </many-to-one>
            <one-to-many name="exits" mapped-by="room" orphan-removal="true">
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </entity>

    <entity class="mudmk3.domain.room.Exit">
        <table name="room_exit">
            <unique-constraint name="UK_ROOM_EXIT_ROOM_ID_DIRECTION">
                <column-name>room_id</column-name>
                <column-name>direction</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <basic name="direction">
                <column name="direction" length="16" nullable="false" column-definition="varchar(16)"/>
                <enumerated>STRING</enumerated>
            </basic>
            <many-to-one name="room" fetch="LAZY" optional="false">
                <join-column name="room_id" nullable="false"/>
            </many-to-one>
            <many-to-one name="target" fetch="LAZY" optional="false">
                <join-column name="target_room_id" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>

    <entity class="mudmk3.domain.world.WorldSettings">
        <table name="world_settings"/>
        <attributes>
            <many-to-one name="startRoom" fetch="LAZY">
                <join-column name="start_room_id" nullable="true"/>
            </many-to-one>
            <!-- 물건 종류는 id로만 갖는다(FK 없음, 쓰이는 종류는 지우지 못하게 서비스가 막는다). 같은 물건 두 줄 금지는 도메인이 지킨다 -->
            <element-collection name="startingItems">
                <order-column name="position"/>
                <collection-table name="world_starting_item">
                    <join-column name="world_settings_id"/>
                </collection-table>
            </element-collection>
        </attributes>
    </entity>

    <entity class="mudmk3.domain.account.Account">
        <table name="account">
            <unique-constraint name="UK_ACCOUNT_GOOGLE_SUBJECT">
                <column-name>google_subject</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <basic name="googleSubject">
                <column name="google_subject" length="255" nullable="false"/>
            </basic>
            <embedded name="email"/>
        </attributes>
    </entity>

    <entity class="mudmk3.domain.character.PlayerCharacter">
        <table name="player_character">
            <unique-constraint name="UK_PLAYER_CHARACTER_ACCOUNT_ID">
                <column-name>account_id</column-name>
            </unique-constraint>
            <unique-constraint name="UK_PLAYER_CHARACTER_NAME">
                <column-name>name</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <basic name="accountId">
                <column name="account_id" nullable="false"/>
            </basic>
            <!-- 방은 지울 때 캐릭터를 다른 방으로 옮기므로 FK를 두지 않는다 -->
            <basic name="roomId">
                <column name="room_id" nullable="false"/>
            </basic>
            <embedded name="name"/>
        </attributes>
    </entity>

    <entity class="mudmk3.domain.npc.Npc">
        <table name="npc">
            <unique-constraint name="UK_NPC_NAME">
                <column-name>name</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <basic name="name">
                <column name="name" length="12" nullable="false"/>
            </basic>
            <basic name="greeting">
                <column name="greeting" length="500" nullable="false"/>
            </basic>
            <basic name="defaultAnswer">
                <column name="default_answer" length="500" nullable="false"/>
            </basic>
            <basic name="llmEnabled">
                <column name="llm_enabled" nullable="false"/>
            </basic>
            <!-- 방을 지우면 배치만 풀므로 FK를 두지 않는다 -->
            <basic name="roomId">
                <column name="room_id" nullable="true"/>
            </basic>
            <!-- 낱말 유일은 도메인이 지킨다. 목록을 통째로 바꿀 때 위치 갱신 순서로 생기는 일시 충돌을 피하려고 DB 유니크 제약은 두지 않는다 -->
            <element-collection name="topics">
                <order-column name="position"/>
                <collection-table name="npc_topic">
                    <join-column name="npc_id"/>
                </collection-table>
            </element-collection>
        </attributes>
    </entity>

    <entity class="mudmk3.domain.item.ItemType">
        <table name="item_type">
            <unique-constraint name="UK_ITEM_TYPE_NAME">
                <column-name>name</column-name>
            </unique-constraint>
            <unique-constraint name="UK_ITEM_TYPE_SPIRIT_STONE_GRADE">
                <column-name>spirit_stone_grade</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <basic name="name">
                <column name="name" length="20" nullable="false"/>
            </basic>
            <basic name="description">
                <column name="description" length="500" nullable="false"/>
            </basic>
            <basic name="category">
                <column name="category" length="32" nullable="false" column-definition="varchar(32)"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="baseValue">
                <column name="base_value" nullable="false"/>
            </basic>
            <basic name="tradable">
                <column name="tradable" nullable="false"/>
            </basic>
            <basic name="bagGrade">
                <column name="bag_grade" length="16" nullable="true" column-definition="varchar(16)"/>
                <enumerated>STRING</enumerated>
            </basic>
            <!-- 엔진이 심는 영석만 값이 있다. 등급마다 하나뿐이다 -->
            <basic name="spiritStoneGrade">
                <column name="spirit_stone_grade" length="16" nullable="true" column-definition="varchar(16)"/>
                <enumerated>STRING</enumerated>
            </basic>
        </attributes>
    </entity>

    <entity class="mudmk3.domain.inventory.Inventory">
        <table name="inventory">
            <unique-constraint name="UK_INVENTORY_CHARACTER_ID">
                <column-name>character_id</column-name>
            </unique-constraint>
        </table>
        <attributes>
            <!-- 캐릭터는 id로만 갖는다(FK 없음) -->
            <basic name="characterId">
                <column name="character_id" nullable="false"/>
            </basic>
            <one-to-many name="entries" mapped-by="inventory" orphan-removal="true">
                <order-by>id</order-by>
                <cascade>
                    <cascade-all/>
                </cascade>
            </one-to-many>
        </attributes>
    </entity>

    <!-- (inventory_id, item_type_id, bound) 묶음 유일은 도메인이 지킨다. 결제에서 하품을 다 내고 거스름 하품을 받을 때처럼
         한 트랜잭션에서 같은 묶음을 비웠다 채울 때 생기는 일시 충돌을 피하려고 DB 유니크 제약은 두지 않는다 -->
    <entity class="mudmk3.domain.inventory.InventoryEntry">
        <table name="inventory_entry"/>
        <attributes>
            <basic name="bound">
                <column name="bound" nullable="false"/>
            </basic>
            <basic name="count">
                <column name="count" nullable="false"/>
            </basic>
            <many-to-one name="inventory" fetch="LAZY" optional="false">
                <join-column name="inventory_id" nullable="false"/>
            </many-to-one>
            <many-to-one name="itemType" fetch="LAZY" optional="false">
                <join-column name="item_type_id" nullable="false"/>
            </many-to-one>
        </attributes>
    </entity>

    <embeddable class="mudmk3.domain.character.CharacterName">
        <attributes>
            <basic name="value">
                <column name="name" length="6" nullable="false"/>
            </basic>
        </attributes>
    </embeddable>

    <embeddable class="mudmk3.domain.npc.NpcTopic">
        <attributes>
            <basic name="word">
                <column name="word" length="20" nullable="false"/>
            </basic>
            <basic name="answer">
                <column name="answer" length="1000" nullable="false"/>
            </basic>
        </attributes>
    </embeddable>

    <embeddable class="mudmk3.domain.world.StartingItem">
        <attributes>
            <basic name="itemTypeId">
                <column name="item_type_id" nullable="false"/>
            </basic>
            <basic name="count">
                <column name="count" nullable="false"/>
            </basic>
        </attributes>
    </embeddable>

    <embeddable class="mudmk3.domain.shared.Email">
        <attributes>
            <basic name="address">
                <column name="email_address" length="320" nullable="false"/>
            </basic>
        </attributes>
    </embeddable>
</entity-mappings>
